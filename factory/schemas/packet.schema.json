{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory/packet.schema.json",
  "title": "packet",
  "description": "The packet block of a decision file (module 11). Every field the picker shows is required, so a skill that leaves one out fails its gate.",
  "type": "object",
  "properties": {
    "stage": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "properties": {
              "what": {
                "type": "string"
              },
              "example": {
                "type": "string"
              },
              "terms": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "what",
              "example",
              "terms"
            ]
          },
          "compare": {
            "type": "object",
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "choose_a_if": {
                "type": "string"
              },
              "choose_b_if": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "a",
              "b",
              "rows",
              "choose_a_if",
              "choose_b_if"
            ]
          },
          "recommend": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "flow": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pros": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "flow",
                "pros",
                "cons"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "question",
          "context",
          "compare",
          "recommend",
          "why",
          "options"
        ]
      }
    },
    "sha": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "stage",
    "decisions",
    "sha"
  ]
}
