{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory/request.schema.json",
  "title": "request",
  "description": "Generated from factory_engine.types.Request by factory_engine.schemagen; do not edit by hand.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "body_sha": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "type_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "source",
    "body_sha",
    "repo",
    "title",
    "type",
    "type_source",
    "priority",
    "acceptance"
  ],
  "additionalProperties": false,
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "cli",
            "markdown",
            "github"
          ]
        },
        "ref": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "ref",
        "title",
        "body",
        "labels",
        "author",
        "files"
      ],
      "additionalProperties": false
    }
  }
}
