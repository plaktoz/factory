{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory/triage.schema.json",
  "title": "triage",
  "description": "The result of triage (module 4, triage_rules): type, workflow, confidence, type_source. Written by hand from module 4.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "type_source": {
      "enum": [
        "explicit",
        "label",
        "front_matter",
        "keyword",
        "llm"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "workflow",
    "confidence",
    "type_source"
  ]
}
