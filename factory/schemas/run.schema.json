{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory/run.schema.json",
  "title": "run",
  "description": "Generated from factory_engine.types.Run by factory_engine.schemagen; do not edit by hand.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "repo": {
      "type": "string"
