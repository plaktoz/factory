    "schema_version",
    "run_id",
    "repo",
    "repo_key",
    "repo_path",
    "request",
    "workflow",
    "branch",
    "worktree",
    "status",
    "stage",
    "stages",
    "loops",
    "attention",
    "pr",
    "signals",
    "heartbeat",
    "kit_hash",
    "infra_wait"
