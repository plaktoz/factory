    "loops": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "attention": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttentionItem"
        },
        {
          "type": "null"
        }
      ]
    },
    "pr": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "signals": {
      "anyOf": [
        {
          "$ref": "#/$defs/Signals"
        },
        {
          "type": "null"
        }
      ]
    },
    "heartbeat": {
      "type": "string"
    },
    "kit_hash": {
      "type": "string"
    },
    "infra_wait": {
      "anyOf": [
        {
          "$ref": "#/$defs/InfraWait"
        },
        {
          "type": "null"
        }
      ]
    }
