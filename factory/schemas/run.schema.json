      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "cli",
            "markdown",
            "github"
          ]
        },
        "ref": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author": {
